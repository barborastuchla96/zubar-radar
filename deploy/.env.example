# Your domain, without https:// (e.g. berepacienty.cz). DNS A record must point here.
DOMAIN=example.cz
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com
# Generated by setup-server.sh. Hex only (it goes into a URL).
POSTGRES_PASSWORD=
REPORT_SALT=
# Direct link to the NRPZS "Místa poskytování" CSV, for the monthly import.
NRPZS_URL=
# none | direct | sklik   (see README "Ads & cookies")
ADS_PROVIDER=none
# Optional cookieless analytics (Umami): script URL + website id.
ANALYTICS_SRC=
ANALYTICS_ID=
# Search-engine site verification codes (only the code from content="...").
SEZNAM_WMT=
GOOGLE_SITE_VERIFICATION=
