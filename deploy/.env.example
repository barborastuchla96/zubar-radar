# Your domain, without https:// (e.g. prijimanovepacienty.cz). DNS A record must point here.
DOMAIN=example.cz
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com
# Generated by setup-server.sh. Hex only (it goes into a URL).
POSTGRES_PASSWORD=
REPORT_SALT=
# Direct link to the NRPZS "Místa poskytování" CSV, for the monthly import.
NRPZS_URL=
# none | direct | sklik   (see README "Ads & cookies")
ADS_PROVIDER=none
# Optional cookieless analytics (Umami): script URL + website id.
ANALYTICS_SRC=
ANALYTICS_ID=
# Search-engine site verification codes (only the code from content="...").
SEZNAM_WMT=
GOOGLE_SITE_VERIFICATION=
# Old domains that should permanently redirect to DOMAIN, space-separated (www. is added automatically).
REDIRECT_FROM=
# Public contact address shown on the site (hidden while empty).
CONTACT_EMAIL=
# Email alerts (sign-up form + daily alert job). Leave SMTP_HOST empty to keep alerts off.
# Wedos: SMTP_HOST=wes1-smtp.wedos.net SMTP_PORT=465 SMTP_USER=info@yourdomain.cz
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender address (defaults to SMTP_USER). Emails per 24 h, all kinds together (Wedos limit is 500).
MAIL_FROM=
MAIL_DAILY_LIMIT=450
