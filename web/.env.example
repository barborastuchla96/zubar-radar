DATABASE_URL=postgresql://user:pass@localhost/radar
SITE_URL=https://www.example.cz
# Random secret used to hash reporter IPs (never stored raw). Required in production.
REPORT_SALT=change-me
# none | direct | sklik (see deploy/README.md "Ads & cookies"). Read at runtime.
ADS_PROVIDER=none
# Optional cookieless analytics (Umami): script URL + website id.
ANALYTICS_SRC=
ANALYTICS_ID=
