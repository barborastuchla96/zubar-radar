---
import '../styles/global.css';
import { SITE_NAME, SPECIALTIES, adsProvider, analytics } from '../lib/site';

const cmp = import.meta.glob<string>('../ads/cmp-head.html', { query: '?raw', import: 'default', eager: true })['../ads/cmp-head.html'];
const cmpHtml = adsProvider() === 'sklik' ? cmp : undefined;
const stats = analytics();
// Search-engine ownership checks, set in deploy/.env (no rebuild needed, just restart).
const seznamWmt = process.env.SEZNAM_WMT;
const googleVerification = process.env.GOOGLE_SITE_VERIFICATION;

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  activeSpecialty?: string;
}
const { title, description, noindex = false, activeSpecialty } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {seznamWmt && <meta name="seznam-wmt" content={seznamWmt} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {cmpHtml && <Fragment set:html={cmpHtml} />}
    {stats && <script is:inline defer src={stats.src} data-website-id={stats.id}></script>}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="logo">Přijímá <span>nové pacienty?</span></a>
        <nav class="nav" aria-label="Obory">
          {SPECIALTIES.map((s) => (
            <a href={`/${s.slug}`} aria-current={s.slug === activeSpecialty ? 'page' : undefined}>{s.short}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>{SITE_NAME}</strong> není oficiální služba. Seznam poskytovatelů vychází z
          Národního registru poskytovatelů zdravotních služeb (ÚZIS ČR); informace o přijímání
          nových pacientů pocházejí od uživatelů a ordinací a nemusí být aktuální.
          Před návštěvou vždy zavolejte do ordinace.
        </p>
        <p>
          Nemůžete najít lékaře? Vaše zdravotní pojišťovna má ze zákona povinnost pomoci vám
          ho najít.
        </p>
        <p><a href="/pro-ordinace">Pro ordinace</a> · <a href="/o-projektu">O projektu a ochrana údajů</a> · <a href="/cookies">Cookies</a></p>
      </div>
    </footer>
  </body>
</html>
