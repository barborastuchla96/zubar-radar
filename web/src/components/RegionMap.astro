---
// Clickable map of the 14 regions. Plain links, so it works without JavaScript.
// Region boundaries © ČÚZK (INSPIRE), CC BY 4.0 — see tools/region_map.py.
import { REGIONS, REGION_VIEWBOX } from '../lib/regions';
import { regionUrl } from '../lib/site';

// fills/titles: optional per-region colour and tooltip (the availability map)
interface Props { specialty: string; active?: string; syncWith?: string; fills?: Record<string, string>; titles?: Record<string, string>; pills?: boolean }
const { specialty, active, syncWith, fills = {}, titles = {}, pills = true } = Astro.props;
---
<div class="region-map" data-sync={syncWith}>
  <svg viewBox={REGION_VIEWBOX} role="group" aria-label="Mapa krajů České republiky">
    {REGIONS.map((r) => (
      <a href={regionUrl(specialty, r.slug)} data-kraj={r.slug} aria-label={r.name}
         aria-current={r.slug === active ? 'page' : undefined}>
        <title>{titles[r.slug] ?? r.name}</title>
        <path d={r.d} class={`kraj${r.slug === 'hlavni-mesto-praha' ? ' praha' : ''}`} style={fills[r.slug] ? `--fill:${fills[r.slug]}` : undefined} />
      </a>
    ))}
    {/* Names on top of all regions, so a neighbouring region never covers part of one. */}
    <g aria-hidden="true">
      {REGIONS.map((r) => (
        <text x={r.lx} y={r.ly} data-kraj={r.slug} class={`kraj-label${r.slug === 'hlavni-mesto-praha' ? ' praha' : ''}${r.slug === active ? ' current' : ''}`}
              text-anchor="middle" dominant-baseline="middle">{r.label}</text>
      ))}
    </g>
  </svg>
  <style is:inline set:html={REGIONS.map((r) => `.region-map svg:has(a[data-kraj="${r.slug}"]:is(:hover,:focus-visible)) .kraj-label[data-kraj="${r.slug}"]`).join(',') + '{fill:var(--brand-ink);stroke:var(--brand)}'} />
  {pills && <ul class="pills region-pills">
    {[...REGIONS].sort((a, b) => (a.slug === 'hlavni-mesto-praha' ? -1 : b.slug === 'hlavni-mesto-praha' ? 1
        : a.name.localeCompare(b.name, 'cs'))).map((r) => (
      <li><a href={regionUrl(specialty, r.slug)} data-kraj={r.slug} aria-current={r.slug === active ? 'page' : undefined}>{r.name}</a></li>
    ))}
  </ul>}
  <p class="small muted map-credit">Hranice krajů © <a href="/o-projektu">ČÚZK, CC BY 4.0</a></p>
</div>

<script>
  // On the homepage the map follows the "Koho hledáte?" choice (a select, or a form with radio tiles).
  document.querySelectorAll<HTMLElement>('.region-map[data-sync]').forEach((map) => {
    const el = document.getElementById(map.dataset.sync!);
    if (!el) return;
    const select = { get value() {
      return el instanceof HTMLSelectElement ? el.value
        : ((el as HTMLFormElement).elements.namedItem('s') as RadioNodeList).value || 'zubar';
    } };
    // setAttribute, not .href: inside the SVG these are SVG links, whose href is read-only
    const update = () => map.querySelectorAll<HTMLElement>('a[data-kraj]').forEach((a) => {
      const k = a.dataset.kraj;
      a.setAttribute('href', k === 'hlavni-mesto-praha' ? `/${select.value}/praha` : `/${select.value}/kraj/${k}`);
    });
    el.addEventListener('change', update);
    update();
  });
</script>
