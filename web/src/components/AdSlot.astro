---
// Network ad slot. Renders only with ADS_PROVIDER=sklik and a snippet file
// in src/ads/<slot>.html (pasted from the Sklik admin). Network ads rely on
// the CMP in src/ads/cmp-head.html for consent; see src/ads/README.md.
import { adsProvider } from '../lib/site';

const snippets = import.meta.glob<string>('../ads/*.html', { query: '?raw', import: 'default', eager: true });
interface Props { name: string }
const { name } = Astro.props;
const html = adsProvider() === 'sklik' ? snippets[`../ads/${name}.html`] : undefined;
---
{html && <aside class="ad" data-ad-slot={name}><Fragment set:html={html} /></aside>}
