---
// Leaflet map of providers. Tiles: Mapy.com when MAPY_API_KEY is set (deploy/.env),
// otherwise OpenStreetMap's community server (fine only for small traffic).
// The key is public by nature (the browser loads the tiles); limit its use in the Mapy.com console.
import type { ProviderRow } from '../lib/db';
import { address, formatPhone, STATUS_LABEL, telHref } from '../lib/site';
import { STATUS_EN, doctorUrl, langOf } from '../lib/i18n';

interface Props { providers: ProviderRow[] }
const mapyKey = (process.env.MAPY_API_KEY ?? '').trim();
const lang = langOf(Astro.url);
const points = Astro.props.providers
  .filter((p) => p.lat != null && p.lng != null)
  .map((p) => {
    const st = STATUS_LABEL[p.status] ?? STATUS_LABEL.unknown;
    const label = lang === 'en' ? (STATUS_EN[p.status] ?? STATUS_EN.unknown).label : st.label;
    return {
      id: p.id, lat: p.lat, lng: p.lng, name: p.name, url: doctorUrl(lang, p), status: p.status, label, icon: st.icon,
      addr: address(p), phone: p.phone ? formatPhone(p.phone) : null, tel: p.phone ? telHref(p.phone) : null,
    };
  });
---
{points.length > 0 && <div id="map" class={points.length === 1 ? "single" : undefined} data-points={JSON.stringify(points)} data-mapy={mapyKey || undefined} data-lang={lang} role="region" aria-label={lang === 'en' ? 'Map of practices' : 'Mapa ordinací'}></div>}

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface Pt { id: number; lat: number; lng: number; name: string; url: string; status: string; label: string; icon: string; addr: string; phone: string | null; tel: string | null }

  /** Small card shown when a pin is tapped: built from DOM nodes, so names can't inject HTML. */
  function popup(p: Pt): HTMLElement {
    const div = document.createElement('div');
    div.className = 'map-popup';
    const h = document.createElement('a'); h.href = p.url; h.className = 'mp-name'; h.textContent = p.name;
    const badge = document.createElement('span'); badge.className = `badge ${p.status}`; badge.textContent = `${p.icon} ${p.label}`;
    const addr = document.createElement('div'); addr.className = 'mp-addr'; addr.textContent = p.addr;
    div.append(h, badge, addr);
    if (p.tel && p.phone) {
      const call = document.createElement('a'); call.href = p.tel; call.className = 'btn call mp-call'; call.textContent = `📞 ${p.phone}`;
      call.dataset.callId = String(p.id); call.dataset.callName = p.name;
      div.append(call);
    }
    const more = document.createElement('a'); more.href = p.url; more.className = 'mp-more'; more.textContent = document.documentElement.lang === 'en' ? 'Details and contact →' : 'Podrobnosti a kontakt →';
    div.append(more);
    return div;
  }

  const el = document.getElementById('map');
  // Inside a folded "Zobrazit na mapě" box, wait until it is opened: Leaflet needs a visible box.
  const box = el?.closest('details');
  if (el && box && !box.open) box.addEventListener('toggle', () => { if (box.open && !el.dataset.ready) init(); });
  else if (el) init();

  function init() {
    if (!el) return;
    el.dataset.ready = '1';
    const pts: Pt[] = JSON.parse(el.dataset.points ?? '[]');
    const map = L.map(el, { scrollWheelZoom: false });
    const key = el.dataset.mapy;
    if (key) {
      // Mapy.com terms: show their copyright link and logo.
      const size = window.devicePixelRatio > 1 ? '256@2x' : '256';
      L.tileLayer(`https://api.mapy.com/v1/maptiles/basic/${size}/{z}/{x}/{y}?apikey=${encodeURIComponent(key)}`, {
        minZoom: 0, maxZoom: 19, tileSize: 256,
        attribution: '<a href="https://api.mapy.com/copyright" target="_blank" rel="noopener">&copy; Seznam.cz a.s. ' + (el.dataset.lang === 'en' ? 'and others' : 'a další') + '</a>',
      }).addTo(map);
      const Logo = L.Control.extend({
        options: { position: 'bottomleft' },
        onAdd() {
          const a = L.DomUtil.create('a');
          a.href = 'https://mapy.com/'; a.target = '_blank'; a.rel = 'noopener';
          a.innerHTML = '<img src="https://api.mapy.com/img/api/logo.svg" alt="Mapy.com" width="100" height="25" style="display:block">';
          L.DomEvent.disableClickPropagation(a);
          return a;
        },
      });
      new Logo().addTo(map);
    } else {
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, attribution: '&copy; OpenStreetMap',
      }).addTo(map);
    }
    // Known statuses are small text tags ("✓ Přijímá"); "don't know yet" stays a small quiet dot.
    const TAG: Record<string, string> = el.dataset.lang === 'en'
      ? { accepting: '✓ Accepting', waitlist: '⏳ Waiting list', mixed: '! Unclear', not_accepting: '✗ Not accepting' }
      : { accepting: '✓ Přijímá', waitlist: '⏳ Pořadník', mixed: '! Nejasné', not_accepting: '✗ Nepřijímá' };
    const group = L.featureGroup();
    for (const p of pts) {
      const known = p.status !== 'unknown';
      const icon = known
        ? L.divIcon({ html: `<span class="map-tag tag-${p.status}">${TAG[p.status] ?? p.label}</span>`, className: 'tag-wrap',
                      iconSize: [0, 0], iconAnchor: [0, 0], popupAnchor: [0, -26] })
        : L.divIcon({ html: '<span class="pin-dot"></span>', className: 'tag-wrap', iconSize: [14, 14], iconAnchor: [7, 7], popupAnchor: [0, -6] });
      const m = L.marker([p.lat, p.lng], { icon, title: `${p.name}: ${p.label}`, zIndexOffset: p.status === 'accepting' ? 1000 : known ? 500 : 0, riseOnHover: true });
      m.bindPopup(popup(p), { minWidth: 220, maxWidth: 280 });
      group.addLayer(m);
    }
    group.addTo(map);
    if (pts.length === 1) map.setView([pts[0].lat, pts[0].lng], 15);
    else map.fitBounds(group.getBounds(), { padding: [20, 20], maxZoom: 15 });
  }
</script>
