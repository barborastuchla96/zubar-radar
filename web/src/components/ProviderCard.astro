---
import StatusBadge from './StatusBadge.astro';
import { address, ago, formatPhone, providerUrl, telHref } from '../lib/site';
import type { ProviderRow } from '../lib/db';

interface Props { p: ProviderRow & { km?: number } }
const { p } = Astro.props;
const when = ago(p.last_signal_at);
---
<article class="card provider" data-status={p.status}>
  <h3><a href={providerUrl(p)}>{p.name}</a></h3>
  <div class="meta">
    <StatusBadge status={p.status} />
    {when && <span>{p.last_source === 'web_crawl' ? `podle webu ordinace, zkontrolováno ${when}` : `ověřeno ${when}`}</span>}
    {p.km != null && <span>{p.km.toLocaleString('cs')} km od vás</span>}
  </div>
  <div class="addr">{address(p)}</div>
  <div class="actions">
    {p.phone
      ? <a class="btn call" href={telHref(p.phone)} aria-label={`Zavolat do ordinace ${p.name}: ${formatPhone(p.phone)}`}>📞 {formatPhone(p.phone)}</a>
      : <a class="btn secondary" href={providerUrl(p)}>Kontakt a podrobnosti</a>}
    <a class="report-link" href={`${providerUrl(p)}#nahlasit`}>Volali jste? Dejte vědět</a>
  </div>
</article>
