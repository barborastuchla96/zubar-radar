---
// Plain-language key to the status badges. The labels are always visible;
// the explanations open on tap, so the list isn't pushed down on phones.
import StatusBadge from './StatusBadge.astro';
---
<details class="legend card">
  <summary>
    <span class="legend-title">Štítky:</span>
    <StatusBadge status="accepting" /> <StatusBadge status="waitlist" />
    <StatusBadge status="not_accepting" /> <StatusBadge status="unknown" />
    <span class="legend-more">Co znamenají?</span>
  </summary>
  <dl>
    <dt><StatusBadge status="accepting" /></dt><dd>Podle nedávných zpráv přijímá nové pacienty.</dd>
    <dt><StatusBadge status="waitlist" /></dt><dd>Zapisuje nové pacienty do pořadníku.</dd>
    <dt><StatusBadge status="not_accepting" /></dt><dd>Podle nedávných zpráv nové pacienty nepřijímá.</dd>
    <dt><StatusBadge status="unknown" /></dt><dd>Zatím o tom nemáme zprávy.</dd>
  </dl>
</details>
