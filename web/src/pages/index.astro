---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import RegionMap from '../components/RegionMap.astro';
import Suggest from '../components/Suggest.astro';
import { cities } from '../lib/db';
import { SITE_NAME, SPECIALTIES, TAGLINE, cityUrl, ordinaci, prijima } from '../lib/site';

// Nationwide counts per specialty, for the "Koho hledáte?" tiles.
const totals = await Promise.all(SPECIALTIES.map(async (s) => {
  const all = await cities(s.slug, 1);
  return { s, n: all.reduce((t, c) => t + c.n, 0), accepting: all.reduce((t, c) => t + c.accepting, 0) };
}));
// Regional capitals: the places people most often look for.
const BIG = [['praha', 'Praha'], ['brno', 'Brno'], ['ostrava', 'Ostrava'], ['plzen', 'Plzeň'], ['liberec', 'Liberec'],
  ['olomouc', 'Olomouc'], ['ceske-budejovice', 'České Budějovice'], ['hradec-kralove', 'Hradec Králové'],
  ['usti-nad-labem', 'Ústí nad Labem'], ['pardubice', 'Pardubice'], ['zlin', 'Zlín'], ['jihlava', 'Jihlava'],
  ['karlovy-vary', 'Karlovy Vary']] as const;
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---
<Base title={`${SITE_NAME} – ${TAGLINE}`} description="Najděte zubaře, praktického či dětského lékaře, gynekologa nebo specialistu, který přijímá nové pacienty. Podle zpráv pacientů a ordinací.">
  <section class="hero">
    <h1 class="hero-title"><span>Hledáte zubaře nebo lékaře,</span> <span>který vás vezme?</span></h1>
    <p>
      Všechny ordinace z oficiálního registru na jednom místě. U každé uvidíte, jestli podle
      posledních zpráv <strong>přijímá nové pacienty</strong> a jak čerstvá ta informace je.
    </p>
    <p class="small"><a href="/en" hreflang="en" lang="en">🌐 In English: find an English-speaking doctor →</a></p>
  </section>

  <form id="home-search" class="home-search" method="get" action="/hledat" role="search">
    <fieldset class="step-box">
      <legend><span class="step-no">1</span> Koho hledáte?</legend>
      {[totals.filter((t) => !t.s.specialist), totals.filter((t) => t.s.specialist)].map((group, g) => (
        <>
          {g === 1 && <p class="tile-group">Specialisté</p>}
          <div class={`grid grid-cards${g === 1 ? ' compact' : ''}`}>
            {group.map(({ s, n, accepting }, i) => (
              <label class="card spec-tile pick">
                <input type="radio" name="s" value={s.slug} checked={g === 0 && i === 0} />
                <span class="icon" aria-hidden="true">{s.icon}</span>
                <strong class="tile-title">{s.plural}</strong>
                <span class="tile-stats">
                  <span class="nowrap">{ordinaci(n)}</span>
                  {accepting > 0 && <span class="nowrap tile-ok">✓ {prijima(accepting)}</span>}
                </span>
              </label>
            ))}
          </div>
        </>
      ))}
    </fieldset>

    <fieldset class="step-box">
      <legend><span class="step-no">2</span> Kde?</legend>
      <label for="home-q">Napište město, obec, část Prahy nebo PSČ</label>
      <div class="search-row">
        <div class="suggest-wrap">
          <input id="home-q" name="q" type="search" required autocomplete="off" placeholder="Např. Dejvice, Kladno, 602 00"
                 data-suggest data-spec-from="home-search" />
        </div>
        <button class="btn big" type="submit">Hledat</button>
      </div>
    </fieldset>
  </form>

  <form method="get" action="/blizko" class="near" id="near-form">
    <input type="hidden" name="s" value="zubar" />
    <input type="hidden" name="lat" /><input type="hidden" name="lng" />
    <span class="muted">nebo</span>
    <button class="btn secondary" type="submit" id="near-btn">📍 Ukázat ordinace v mém okolí</button>
  </form>
  <p class="small muted" id="near-msg" hidden></p>
  <ul class="pills big-cities" aria-label="Krajská města">
    {BIG.map(([slug, name]) => <li><a href={cityUrl('zubar', slug)} data-city={slug}>{name}</a></li>)}
  </ul>

  <h2 class="map-title">Nebo klikněte na svůj kraj</h2>
  <div class="home-region">
  <RegionMap specialty="zubar" syncWith="home-search" />
  </div>

  <Suggest />

  <AdSlot name="home-mid" />

  <h2>Jak to funguje</h2>
  <div class="grid grid-2">
    <div class="card"><strong>1. Najděte ordinaci ve svém okolí</strong><p class="small muted">Vyberte obor a zadejte lokalitu, nebo klikněte na mapu. Najdete tu všechny ordinace z oficiálního registru ministerstva zdravotnictví.</p></div>
    <div class="card"><strong>2. Podívejte se, kde přijímají nové pacienty</strong><p class="small muted">Zelený štítek označuje ordinace, kde na základě aktuálních zpráv přijímají nové pacienty. U každé vidíte, odkud a jak čerstvá je poslední zpráva.</p></div>
    <div class="card"><strong>3. Víte víc? Dejte vědět ostatním!</strong><p class="small muted">Když zjistíte, že některá z ordinací přijímá nové pacienty, můžete to tu jedním klepnutím označit. Je to dobrovolné. Pomůžete tím ale ostatním, kteří budou vědět, kde je vezmou!</p></div>
  </div>
</Base>

<script>
  const search = document.getElementById('home-search') as HTMLFormElement;
  const chosen = () => (search.elements.namedItem('s') as RadioNodeList).value || 'zubar';

  // City shortcuts follow the specialty tiles.
  const syncCities = () => document.querySelectorAll<HTMLAnchorElement>('a[data-city]').forEach((a) => {
    a.href = `/${chosen()}/${a.dataset.city}`;
  });
  search.addEventListener('change', syncCities);
  syncCities();

  const form = document.getElementById('near-form') as HTMLFormElement;
  const msg = document.getElementById('near-msg')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    (form.elements.namedItem('s') as HTMLInputElement).value = chosen();
    if (!navigator.geolocation) { msg.hidden = false; msg.textContent = 'Váš prohlížeč polohu nepodporuje.'; return; }
    msg.hidden = false; msg.textContent = 'Zjišťuji polohu… Prohlížeč se vás možná zeptá, jestli ji smí použít.';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        (form.elements.namedItem('lat') as HTMLInputElement).value = pos.coords.latitude.toFixed(4);
        (form.elements.namedItem('lng') as HTMLInputElement).value = pos.coords.longitude.toFixed(4);
        form.submit();
      },
      () => { msg.textContent = 'Polohu se nepodařilo zjistit. Napište prosím místo do vyhledávání výše.'; },
      { timeout: 10000, maximumAge: 600000 },
    );
  });
</script>
