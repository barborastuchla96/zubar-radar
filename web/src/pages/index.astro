---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import PlaceSearch from '../components/PlaceSearch.astro';
import Tile from '../components/Tile.astro';
import { cities } from '../lib/db';
import { FEATURED_CITY, SITE_NAME, SPECIALTIES, TAGLINE, cityUrl, isPragueSlug } from '../lib/site';

// Provider counts for the launch city, per specialty.
const featured = await Promise.all(
  SPECIALTIES.map(async (s) => {
    const all = await cities(s.slug, 1);
    const inCity = all.filter((x) =>
      FEATURED_CITY.slug === 'praha' ? isPragueSlug(x.city_slug) : x.city_slug === FEATURED_CITY.slug);
    return { s, n: inCity.reduce((t, c) => t + c.n, 0), accepting: inCity.reduce((t, c) => t + c.accepting, 0) };
  }),
);
const topDentistCities = (await cities('zubar', 3, 40)).filter((c) => !isPragueSlug(c.city_slug)).slice(0, 12);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---
<Base title={`${SITE_NAME} – ${TAGLINE}`} description="Najděte zubaře, praktického či dětského lékaře nebo gynekologa, který přijímá nové pacienty. Ověřeno lidmi, kteří tam volali.">
  <section class="hero">
    <h1 class="hero-title"><span>Hledáte zubaře nebo lékaře,</span> <span>který vás vezme?</span></h1>
    <p>
      Všechny ordinace z oficiálního registru na jednom místě. U každé uvidíte, jestli podle
      posledních zpráv <strong>přijímá nové pacienty</strong> a kdy to naposledy někdo ověřil.
    </p>
    <PlaceSearch />
    <form method="get" action="/blizko" class="near" id="near-form">
      <input type="hidden" name="s" value="zubar" />
      <input type="hidden" name="lat" /><input type="hidden" name="lng" />
      <span class="muted">nebo</span>
      <button class="btn secondary" type="submit" id="near-btn">📍 Ukázat ordinace v mém okolí</button>
    </form>
    <p class="small muted" id="near-msg" hidden></p>
  </section>

  <h2>{FEATURED_CITY.name}</h2>
  <div class="grid grid-cards">
    {featured.map(({ s, n, accepting }) => (
      <Tile href={cityUrl(s.slug, FEATURED_CITY.slug)} icon={s.icon} title={s.plural} {n} {accepting} />
    ))}
  </div>

  <AdSlot name="home-mid" />

  <h2>Jak to funguje</h2>
  <div class="grid grid-2">
    <div class="card"><strong>1. Najděte ordinaci</strong><p class="small muted">Seznam přebíráme z Národního registru poskytovatelů zdravotních služeb, takže v něm najdete všechny ordinace.</p></div>
    <div class="card"><strong>2. Podívejte se na stav</strong><p class="small muted">Zelený štítek znamená, že ordinace podle nedávných zpráv přijímá nové pacienty. Starší zprávy se počítají méně.</p></div>
    <div class="card"><strong>3. Zavolejte a dejte vědět</strong><p class="small muted">Po telefonátu nám jedním kliknutím dejte vědět, jak to dopadlo. Ostatním tím ušetříte hodiny obvolávání.</p></div>
  </div>

  <h2>Zubaři v dalších městech</h2>
  <ul class="pills">
    {topDentistCities.map((c) => <li><a href={cityUrl('zubar', c.city_slug)}>{c.city}</a></li>)}
    <li><a class="pill-more" href="/zubar">Všechna města →</a></li>
  </ul>
</Base>

<script>
  const form = document.getElementById('near-form') as HTMLFormElement;
  const msg = document.getElementById('near-msg')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    // Use the specialty chosen in the search box above.
    (form.elements.namedItem('s') as HTMLInputElement).value =
      (document.getElementById('ps-s') as HTMLSelectElement | null)?.value ?? 'zubar';
    if (!navigator.geolocation) { msg.hidden = false; msg.textContent = 'Váš prohlížeč polohu nepodporuje.'; return; }
    msg.hidden = false; msg.textContent = 'Zjišťuji polohu… Prohlížeč se vás možná zeptá, jestli ji smí použít.';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        (form.elements.namedItem('lat') as HTMLInputElement).value = pos.coords.latitude.toFixed(4);
        (form.elements.namedItem('lng') as HTMLInputElement).value = pos.coords.longitude.toFixed(4);
        form.submit();
      },
      () => { msg.textContent = 'Polohu se nepodařilo zjistit. Napište prosím místo do vyhledávání výše.'; },
      { timeout: 10000, maximumAge: 600000 },
    );
  });
</script>
