---
import Base from '../../layouts/Base.astro';
import { confirm, findByToken } from '../../lib/alerts';
import { specialty } from '../../lib/site';

// The link in the email opens this page; the button does the confirming. That way mail
// scanners that pre-open links can't confirm a sign-up for someone else.
const post = Astro.request.method === 'POST';
const token = post ? String((await Astro.request.formData()).get('t') ?? '') : (Astro.url.searchParams.get('t') ?? '');
let sub = await findByToken(token);
// After the button: redirect, so the page visibly changes and a refresh doesn't re-send the form.
if (post && sub) { await confirm(token); return Astro.redirect(`/upozorneni/potvrdit?t=${encodeURIComponent(token)}`, 303); }
const spec = sub ? specialty(sub.specialty_slug) : undefined;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<Base title={sub?.verified_at ? 'Upozornění je zapnuté' : 'Potvrzení upozornění'} description="Potvrzení e-mailového upozornění" noindex>
  <h1>{sub?.verified_at ? '✓ Hotovo, upozornění je zapnuté' : 'Upozornění na volné ordinace'}</h1>
  {!sub && (
    <div class="card"><p>Tento odkaz už neplatí. Možná jste se mezitím odhlásili, nebo od přihlášení uběhl víc než týden.</p>
      <p><a href="/">Zpět na hlavní stránku</a></p></div>
  )}
  {sub && (sub.verified_at) && (
    <div class="card done-card" role="status">
      <p>Jakmile {spec?.some} do {sub.radius_km} km od místa <strong>{sub.place_label}</strong> začne přijímat
        nové pacienty, pošleme vám e-mail. Obvykle ráno, nejvýš jednou denně.</p>
      <p>Upozornění můžete kdykoli zrušit odkazem v každém e-mailu.</p>
      <p><a class="btn secondary" href="/">Zpět na hlavní stránku</a></p></div>
  )}
  {sub && !sub.verified_at && (
    <form class="card" method="post">
      <p>Chcete, abychom vám napsali, až {spec?.some} do {sub.radius_km} km od místa <strong>{sub.place_label}</strong> začne přijímat nové pacienty?</p>
      <input type="hidden" name="t" value={token} />
      <button class="btn" type="submit">Ano, chci upozornění</button>
    </form>
  )}
</Base>
