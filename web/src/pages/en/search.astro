---
import Base from '../../layouts/Base.astro';
import PlaceSearch from '../../components/PlaceSearch.astro';
import { englishCounts } from '../../lib/db';
import { findPlace } from '../../lib/places';
import { SPECIALTIES, isPragueSlug, specialty } from '../../lib/site';
import { acceptingN, enOf, placeUrl, practices, regionEn } from '../../lib/i18n';

const spec = specialty(Astro.url.searchParams.get('s') ?? '') ?? SPECIALTIES[0];
const E = enOf(spec.slug);
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 80);
const englishOnly = Astro.url.searchParams.get('english') === '1';
const englishKnown = (await englishCounts())[spec.slug] ?? 0;
const withFilter = (u: string) => (englishOnly ? `${u}?english=1` : u);

const found = q ? await findPlace(spec.slug, q) : { kind: 'none' as const };
if (found.kind === 'city') return Astro.redirect(withFilter(placeUrl('en', spec.slug, found.slug)), 302);
if (found.kind === 'near') {
  const p = new URLSearchParams({ s: spec.slug, lat: found.lat.toFixed(4), lng: found.lng.toFixed(4), km: '3', misto: found.label });
  if (englishOnly) p.set('english', '1');
  return Astro.redirect(`/en/near?${p}`, 302);
}
const matches = found.kind === 'list' ? found.matches : [];
---
<Base title={`Search: ${q || E.plural}`} description={`${E.plural} – search by town.`} noindex activeSpecialty={spec.slug} alt={`/hledat?s=${spec.slug}&q=${encodeURIComponent(q)}`}>
  <h1>{E.plural}: where are you looking?</h1>
  <PlaceSearch specialty={spec.slug} {q} english={englishOnly} {englishKnown} />
  {q && matches.length === 0 && (
    <p class="notice bad">Nothing found for “{q}”. Try a town name (e.g. “Kladno”), a part of Prague (e.g. “Praha 6” or “Dejvice”), a postcode or a street.
      Or see <a href={`/en/${E.en}`}>all towns</a>.</p>
  )}
  {matches.length > 0 && (
    <>
      <h2>Choose a place</h2>
      <ul class="result-list">
        {matches.map((c) => (
          <li><a href={withFilter(placeUrl('en', spec.slug, c.city_slug))}>
            <strong>{c.city.replace(/ \(okres .*\)$/, '')}</strong>
            <span class="muted">{[isPragueSlug(c.city_slug) ? 'Prague' : c.district ? `${c.district} district` : c.region && regionEn(c.region), practices(c.n)].filter(Boolean).join(' · ')}</span>
            {c.accepting > 0 && <span class="tile-ok">✓ {acceptingN(c.accepting)}</span>}
          </a></li>
        ))}
      </ul>
    </>
  )}
</Base>
