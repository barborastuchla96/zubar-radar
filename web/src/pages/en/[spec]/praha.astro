---
// Prague hub in English: the Praha 1–22 map first, then who accepts (English speakers first).
import Base from '../../../layouts/Base.astro';
import ProviderCard from '../../../components/ProviderCard.astro';
import PlaceSearch from '../../../components/PlaceSearch.astro';
import StatusLegend from '../../../components/StatusLegend.astro';
import Tile from '../../../components/Tile.astro';
import AreaMap from '../../../components/AreaMap.astro';
import SpecialistNote from '../../../components/SpecialistNote.astro';
import { pragueDetail, toMap } from '../../../lib/areas';
import { cities, pragueAccepting } from '../../../lib/db';
import { SPECIALTIES, breadcrumbLd, byDistrict, cityUrl, isPragueSlug } from '../../../lib/site';
import { acceptingN, enOf, factLineEn, monthYearEn, placeUrl, practices, specUrl, specialtyFromEn } from '../../../lib/i18n';

const spec = specialtyFromEn(Astro.params.spec ?? '');
if (!spec) return Astro.rewrite('/404');
const E = enOf(spec.slug);
const districts = (await cities(spec.slug, 1)).filter((c) => isPragueSlug(c.city_slug)).sort(byDistrict);
districts.sort((a, b) => Number(a.city_slug === 'praha') - Number(b.city_slug === 'praha'));
const total = districts.reduce((t, c) => t + c.n, 0);
const acceptingTotal = districts.reduce((t, c) => t + c.accepting, 0);
const accepting = (await pragueAccepting(spec.slug)).sort((a, b) => Number(b.english) - Number(a.english));

const dots = districts.filter((c) => c.lat != null && c.lng != null && c.city_slug !== 'praha').map((c) => {
  const [x, y] = toMap(pragueDetail, c.lat!, c.lng!);
  return {
    href: placeUrl('en', spec.slug, c.city_slug), label: c.city, x, y, r: 19, ok: c.accepting > 0, showLabel: false,
    inner: c.city.replace('Praha ', ''), title: `${c.city}: ${practices(c.n)}${c.accepting ? `, ${acceptingN(c.accepting)}` : ''}`,
  };
});
for (let round = 0; round < 40; round++) {
  for (const a of dots) for (const b of dots) {
    if (a === b) continue;
    const dx = b.x - a.x, dy = b.y - a.y, dist = Math.hypot(dx, dy) || 1, min = a.r + b.r + 3;
    if (dist < min) { const push = (min - dist) / 2; a.x -= dx / dist * push; a.y -= dy / dist * push; b.x += dx / dist * push; b.y += dy / dist * push; }
  }
}
const fact = factLineEn('Prague', E.plural, acceptingTotal, total);
const title = `${E.plural} in Prague accepting new patients – English-speaking (${monthYearEn()})`;
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
const jsonLd = breadcrumbLd(Astro.site, [['Home', '/en'], [E.plural, specUrl('en', spec.slug)], ['Prague', placeUrl('en', spec.slug, 'praha')]]);
---
<Base {title} description={`${fact} By district, with contacts and which practices speak English.`} activeSpecialty={spec.slug} {jsonLd} alt={cityUrl(spec.slug, 'praha')}>
  <div class="crumbs"><a href="/en">Home</a> › <a href={specUrl('en', spec.slug)}>{E.plural}</a> › Prague</div>
  <h1>{E.plural} – Prague</h1>
  <p class="muted fact">{fact}</p>
  <SpecialistNote {spec} />

  <h2>Choose your part of Prague</h2>
  <p class="small muted">Tap your district number. <span class="tile-ok">Green</span> means someone there accepts new patients.</p>
  <AreaMap viewBox={pragueDetail.viewBox} label="Prague districts" outline={pragueDetail.d} {dots} />
  <div class="grid grid-cards compact prague-districts">
    {districts.map((d) => <Tile href={placeUrl('en', spec.slug, d.city_slug)} title={d.city === 'Praha' ? 'Prague (no district)' : d.city} n={d.n} accepting={d.accepting} />)}
  </div>
  <PlaceSearch specialty={spec.slug} q="Praha " compact />

  <h2>Accepting in Prague right now</h2>
  {accepting.length > 0 ? (
    <>
      <StatusLegend />
      <div class="grid grid-2">{accepting.map((p) => <ProviderCard p={p} />)}</div>
    </>
  ) : (
    <p class="card">No report yet of anyone accepting. Pick your district to see all practices and their contacts.</p>
  )}

  <h2>Other doctors in Prague</h2>
  <ul class="pills">{SPECIALTIES.filter((s) => s.slug !== spec.slug).map((s) => <li><a href={placeUrl('en', s.slug, 'praha')}>{enOf(s.slug).plural}</a></li>)}</ul>
</Base>
