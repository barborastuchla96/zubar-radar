---
// English town / Prague-district page. Same data as /[specialty]/[city]; English-speaking
// practices first within each status, and a "Speaks English" filter.
import Base from '../../../layouts/Base.astro';
import ProviderCard from '../../../components/ProviderCard.astro';
import Map from '../../../components/Map.astro';
import StatusLegend from '../../../components/StatusLegend.astro';
import SpecialistNote from '../../../components/SpecialistNote.astro';
import { cityProviders, nearby } from '../../../lib/db';
import { SPECIALTIES, breadcrumbLd, cityUrl, isPragueSlug, placeLabel } from '../../../lib/site';
import { enOf, factLineEn, monthYearEn, placeEn, placeUrl, specUrl, specialtyFromEn } from '../../../lib/i18n';

const spec = specialtyFromEn(Astro.params.spec ?? '');
if (!spec) return Astro.rewrite('/404');
const E = enOf(spec.slug);
const citySlug = Astro.params.city ?? '';
const raw = await cityProviders(spec.slug, citySlug);
if (raw.length === 0) return Astro.rewrite('/404');

const RANK: Record<string, number> = { accepting: 0, waitlist: 1, mixed: 2, unknown: 3, not_accepting: 4 };
const rows = [...raw].sort((a, b) => (RANK[a.status] ?? 3) - (RANK[b.status] ?? 3) || Number(b.english) - Number(a.english));
const city = placeEn(placeLabel(rows[0].city!, rows[0].city_slug!, rows[0].district));
const counts: Record<string, number> = {};
for (const r of rows) counts[r.status] = (counts[r.status] ?? 0) + 1;
const open = (counts.accepting ?? 0) + (counts.waitlist ?? 0);
const speaks = rows.filter((r) => r.english);
const others = rows.filter((r) => !r.english);
const english = speaks.length;
const located = rows.filter((r) => r.lat != null && r.lng != null);
const center = located.length
  ? { lat: located.reduce((t, r) => t + r.lat!, 0) / located.length, lng: located.reduce((t, r) => t + r.lng!, 0) / located.length }
  : null;
const here = new Set(rows.map((r) => r.id));
const around = center
  ? (await nearby(spec.slug, center.lat, center.lng, isPragueSlug(citySlug) ? 2 : 5, rows.length + 6))
      .filter((r) => !here.has(r.id)).slice(0, 6).map(({ km, ...r }) => r)
  : [];
const prague = isPragueSlug(citySlug);
const fact = factLineEn(city, E.plural, counts.accepting ?? 0, rows.length, english);
const title = `${E.plural} in ${city} accepting new patients, incl. English-speaking (${monthYearEn()})`;
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
const jsonLd = breadcrumbLd(Astro.site, [
  ['Home', '/en'], [E.plural, specUrl('en', spec.slug)],
  ...(prague ? [['Prague', placeUrl('en', spec.slug, 'praha')] as [string, string]] : []),
  [city, placeUrl('en', spec.slug, citySlug)],
]);
---
<Base {title} description={`${fact} Contacts, map and which practices speak English.`} noindex={rows.length < 3}
      activeSpecialty={spec.slug} {jsonLd} alt={cityUrl(spec.slug, citySlug)}>
  <div class="crumbs"><a href="/en">Home</a> › <a href={specUrl('en', spec.slug)}>{E.plural}</a> ›
    {prague && <> <a href={placeUrl('en', spec.slug, 'praha')}>Prague</a> ›</>} {city}</div>
  <h1>{E.plural} – {city}</h1>
  <p class="muted fact">{fact}</p>
  <SpecialistNote {spec} />

  <p class="intro">
    {english > 0
      ? <>First the {english === 1 ? 'practice' : `${english} practices`} where we know <strong>you can speak English</strong>, then all the others.</>
      : <>We <strong>don't know yet</strong> which practices here speak English. That doesn't mean they don't: many doctors do, so it's worth asking.</>}
    {' '}In each part, those that recently said they <strong>accept new patients</strong> come first.
  </p>
  <StatusLegend />
  <div class="filters" role="group" aria-label="Show">
    <button class="chip" type="button" data-filter="all" aria-pressed="true">All ({rows.length})</button>
    {open > 0 && <button class="chip" type="button" data-filter="accepting" aria-pressed="false">Accepting ({open})</button>}
  </div>

  <details class="map-toggle" open>
    <summary>🗺️ Show on map</summary>
    <Map providers={rows} />
  </details>
  <script is:inline>
    if (matchMedia('(max-width: 640px)').matches) document.currentScript.previousElementSibling.open = false;
  </script>

  {english > 0 && (
    <section class="list-part">
      <h2>🗣️ You can speak English here ({english})</h2>
      <p class="small muted">According to the practice website or patients' reports.</p>
      <div class="grid grid-2 list">{speaks.map((p) => <ProviderCard p={p} />)}</div>
    </section>
  )}
  <section class="list-part">
    {english > 0
      ? <h2>Other practices ({others.length})</h2>
      : <h2 class="sr-only">Practices</h2>}
    {english > 0 && <p class="notice unknown-english">We <strong>don't know yet</strong> whether these speak English. That doesn't mean they don't:
      many doctors do, so it's worth asking. If you find out, tell others on the practice page.</p>}
    <div class="grid grid-2 list">{others.map((p) => <ProviderCard p={p} />)}</div>
  </section>
  <p class="notice ok" id="empty" hidden>Nothing in this filter.</p>

  {around.length > 0 && (
    <>
      <h2>Nearby – outside {city}</h2>
      <div class="grid grid-2">{around.map((p) => <ProviderCard p={p} />)}</div>
    </>
  )}

  <h2>Other doctors – {city}</h2>
  <ul class="pills">{SPECIALTIES.filter((s) => s.slug !== spec.slug).map((s) => <li><a href={placeUrl('en', s.slug, citySlug)}>{enOf(s.slug).plural}</a></li>)}</ul>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.list article.provider');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    const f = chip.dataset.filter!;
    let shown = 0;
    cards.forEach((card) => {
      const ok = f === 'all' || ['accepting', 'waitlist'].includes(card.dataset.status!);
      card.hidden = !ok; if (ok) shown++;
    });
    document.getElementById('empty')!.hidden = shown > 0;
  }));
</script>
