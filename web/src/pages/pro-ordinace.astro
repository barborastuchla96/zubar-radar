---
import Base from '../layouts/Base.astro';
import { contactEmail } from '../lib/site';
const contact = contactEmail();
const subject = encodeURIComponent('Úprava údajů ordinace');
const body = encodeURIComponent('Dobrý den,\n\nodkaz na profil naší ordinace: \n\nPřijímáme nové pacienty: ano / ne / jen děti / pořadník\n\nDěkujeme');
---
<Base title="Pro ordinace" description="Dejte pacientům vědět, jestli přijímáte. Zdarma.">
  <h1>Pro ordinace</h1>
  <p>Každý den vám volají lidé, kteří hledají lékaře. Když tu označíte, zda přijímáte nové pacienty,
     ušetříte sobě i jim spoustu telefonátů. Vaše vlastní hlášení má vždy přednost před zprávami pacientů.</p>
  <div class="card">
    <h2 style="margin-top:0">Jak na to</h2>
    <p>Napište nám{contact ? <> na <strong>{contact}</strong></> : ''} z e-mailové adresy, kterou má vaše ordinace uvedenou
       v registru poskytovatelů, a přidejte odkaz na profil ordinace u nás. Podle adresy poznáme, že píšete opravdu vy.
       Stav pak upravíme. Je to zdarma.</p>
    {contact
      ? <p><a class="btn" href={`mailto:${contact}?subject=${subject}&body=${body}`}>✉️ Napsat na {contact}</a></p>
      : <p class="muted">Kontaktní e-mail brzy doplníme.</p>}
    <p class="muted small">Samoobslužná správa profilu se připravuje.</p>
  </div>
  <h2>Oprava nebo odstranění údajů</h2>
  <p>Údaje o ordinacích přebíráme z veřejného Národního registru poskytovatelů zdravotních služeb.
     Je-li něco špatně, nebo nesouhlasíte s tím, jak vaše údaje zobrazujeme, napište nám{contact ? <> na <strong>{contact}</strong></> : ''},
     ideálně z adresy, kterou má vaše ordinace v registru. Údaje opravíme, případně stav „přijímá / nepřijímá“ u vaší ordinace skryjeme.</p>
</Base>
