---
// Shown when something breaks on our side (e.g. the database is restarting).
// A 5xx status tells search engines "try again later" instead of "page gone".
import Base from '../layouts/Base.astro';
Astro.response.status = 503;
Astro.response.headers.set('Retry-After', '120');
---
<Base title="Chvilková porucha" description="Web se právě aktualizuje." noindex>
  <h1>Omlouváme se, chvilková porucha</h1>
  <p>Web se pravděpodobně právě aktualizuje. Zkuste to prosím za minutu znovu.</p>
  <p><a class="btn" href="">Načíst znovu</a></p>
</Base>
