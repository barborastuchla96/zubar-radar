---
import SpecialistNote from '../../components/SpecialistNote.astro';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ReportForm from '../../components/ReportForm.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import Map from '../../components/Map.astro';
import AdSlot from '../../components/AdSlot.astro';
import AlertForm from '../../components/AlertForm.astro';
import { alternatives, latestCrawlNote, provider } from '../../lib/db';
import { doctorUrl } from '../../lib/i18n';
import { INSURERS, SPECIALTIES, STATUS_LABEL, address, ago, breadcrumbLd, cityUrl, emailsOf, firstWeb, formatPhone, providerUrl, telHref } from '../../lib/site';

const id = Number((Astro.params.id ?? '').split('-')[0]);
const p = Number.isInteger(id) && id > 0 ? await provider(id) : undefined;
if (!p) return Astro.rewrite('/404');

// One canonical URL per provider (/lekar/123-name). Old or mistyped slugs redirect.
const canonical = providerUrl(p);
if (Astro.url.pathname !== canonical) return Astro.redirect(canonical + Astro.url.search, 301);

const specs = SPECIALTIES.filter((s) => (p.specialties ?? []).includes(s.slug));   // register order: Zubař before Dentální hygiena
const main = specs[0];
const alts = main ? await alternatives(p, main.slug) : [];
const when = ago(p.last_signal_at);
const crawl = p.last_source === 'web_crawl' ? await latestCrawlNote(p.id) : undefined;
const web = firstWeb(p.web);
const emails = emailsOf(p.email);
const result = Astro.url.searchParams.get('r');
const status = STATUS_LABEL[p.status] ?? STATUS_LABEL.unknown;
const desc = `${p.name}, ${address(p)}. ${specs.map((s) => s.singular).join(', ')}. ` +
  `Přijímá nové pacienty? ${status.label}${when ? ` (${crawl ? 'podle webu ordinace' : 'nahlášeno'} ${when})` : ''}.`;
Astro.response.headers.set('Cache-Control', 'private, no-cache');

const SCHEMA_SPECIALTY: Record<string, string> = {
  zubar: 'https://schema.org/Dentistry', hygienistka: 'https://schema.org/Dentistry',
  praktik: 'https://schema.org/PrimaryCare', pediatr: 'https://schema.org/Pediatric', gynekolog: 'https://schema.org/Gynecologic',
  orl: 'https://schema.org/Otolaryngologic', kozni: 'https://schema.org/Dermatology',
  psychiatr: 'https://schema.org/Psychiatric', neurolog: 'https://schema.org/Neurologic',
};
// schema.org: what this practice is and where (public register data only).
const isDental = specs.some((s) => s.slug === 'zubar' || s.slug === 'hygienistka');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': isDental ? 'Dentist' : 'Physician',
    name: p.name,
    url: new URL(canonical, Astro.site).toString(),
    ...(p.phone ? { telephone: p.phone.replace(/\s+/g, '') } : {}),
    ...(web ? { sameAs: web } : {}),
    ...(emails[0] ? { email: emails[0] } : {}),
    // schema.org's own property for exactly this; only when we have a clear current answer
    ...(p.status === 'accepting' ? { isAcceptingNewPatients: true } : p.status === 'not_accepting' ? { isAcceptingNewPatients: false } : {}),
    ...(specs.length ? { medicalSpecialty: specs.map((s) => SCHEMA_SPECIALTY[s.slug]).filter(Boolean) } : {}),
    address: {
      '@type': 'PostalAddress',
      streetAddress: [p.street, p.house_no].filter(Boolean).join(' ') || undefined,
      addressLocality: p.city ?? undefined,
      postalCode: p.postcode ?? undefined,
      addressCountry: 'CZ',
    },
    ...(p.lat != null && p.lng != null ? { geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lng } } : {}),
  },
  breadcrumbLd(Astro.site, [
    ['Úvod', '/'],
    ...(main ? [[main.plural, `/${main.slug}`] as [string, string]] : []),
    ...(main && p.city_slug ? [[p.city ?? '', cityUrl(main.slug, p.city_slug)] as [string, string]] : []),
    [p.name, canonical],
  ]),
];
---
<Base title={`${p.name} – přijímá nové pacienty?`} description={desc} activeSpecialty={main?.slug} {jsonLd} alt={doctorUrl('en', p)}>
  <div class="crumbs">
    <a href="/">Úvod</a>
    {main && <> › <a href={`/${main.slug}`}>{main.plural}</a></>}
    {main && p.city_slug && <> › <a href={cityUrl(main.slug, p.city_slug)}>{p.city}</a></>}
  </div>
  <h1>{p.name}</h1>
  <p style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap">
    <StatusBadge status={p.status} />
    <span class="muted small">{when ? (crawl ? `na webu ordinace, kontrola ${when}` : p.last_source === 'clinic' ? `potvrdila ordinace ${when}` : `poslední hlášení ${when}`) : status.hint}</span>
  </p>
  {p.english && <p class="notice english-note">🗣️ <strong>Domluvíte se anglicky.</strong> Podle webu ordinace nebo zpráv pacientů tu někdo mluví anglicky.</p>}
  {!p.english && p.english_site && <p class="notice unknown-english">🌐 <strong>Web ordinace má i anglickou verzi.</strong> Neznamená to ale, že tu někdo mluví anglicky. Ověřte si to raději telefonicky.</p>}
  {p.self_pay && (
    <p class="notice self-pay-note">💳 <strong>Bez smlouvy se zdravotní pojišťovnou.</strong> Podle webu ordinace nebo hlášení
      pacientů tu všechno platíte sami. Pojišťovna vám péči neproplatí.</p>
  )}
  {specs.find((s) => s.specialist) && <SpecialistNote spec={specs.find((s) => s.specialist)!} />}
  {crawl && (
    <p class="small muted">
      Na webu ordinace jsme našli: {crawl.note.split(' — ')[0]}
      {' '}<a href={crawl.note.split(' — ')[1]} rel="nofollow noopener" target="_blank">zdroj</a>.
      Web ordinace nemusí být aktuální.
    </p>
  )}

  <div class="two-col">
    <div>
      {p.phone && (
        <a class="btn call big full" href={telHref(p.phone)} data-call-id={p.id} data-call-name={p.name}>📞 Zavolat<span class="wide-only">&nbsp;do ordinace</span> <span class="nowrap">{formatPhone(p.phone)}</span></a>
      )}
      {(emails.length > 0 || web) && (
        <div class="contact-row detail">
          {emails[0] && <a class="btn secondary" href={`mailto:${emails[0]}`}>✉️ Napsat e-mail</a>}
          {web && <a class="btn secondary" href={web} rel="nofollow noopener" target="_blank">🌐 Otevřít web ordinace</a>}
        </div>
      )}
      <div class="card">
        <dl class="facts">
          <dt>Adresa</dt><dd>{address(p)}</dd>
          {p.phone && <><dt>Telefon</dt><dd><a href={telHref(p.phone)} data-call-id={p.id} data-call-name={p.name}>{formatPhone(p.phone)}</a></dd></>}
          {emails.length > 0 && <><dt>E-mail</dt><dd>{emails.map((e, i) => <>{i > 0 && <br />}<a href={`mailto:${e}`}>{e}</a></>)}</dd></>}
          {web && <><dt>Web</dt><dd><a href={web} rel="nofollow noopener" target="_blank">{web.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></dd></>}
          {!p.self_pay && p.insurers?.length ? <><dt>Pojišťovny</dt><dd>{p.insurers.map((c) => `${INSURERS[c]} (${c})`).join(', ')} <span class="muted small">(podle webu ordinace nebo hlášení)</span></dd></> : null}
          <dt>Obory</dt><dd>{specs.map((s) => s.singular).join(', ')}</dd>
          {p.facility_type && <><dt>Typ (v registru)</dt><dd>{p.facility_type}</dd></>}
        </dl>
      </div>
      <Map providers={[p]} />
      <p class="small muted">Je tu chyba, nebo jste z této ordinace? <a href="/pro-ordinace">Napište nám</a>, údaje zdarma opravíme.</p>
    </div>
    <ReportForm providerId={p.id} {result} />
  </div>

  <AdSlot name="provider" />

  {main && p.lat != null && p.lng != null && p.status !== 'accepting' && (
    <AlertForm spec={main} lat={p.lat} lng={p.lng} place={p.city ?? 'této ordinace'} radius={p.city_slug?.startsWith('praha') ? 2 : 5} />
  )}
  {alts.length > 0 && main && (
    <section>
      <h2>{main.nearby}</h2>
      <div class="grid grid-2">{alts.map((a) => <ProviderCard p={a} kmFrom="here" />)}</div>
    </section>
  )}
</Base>
