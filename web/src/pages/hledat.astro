---
import Base from '../layouts/Base.astro';
import PlaceSearch from '../components/PlaceSearch.astro';
import { findPlace } from '../lib/places';
import { SPECIALTIES, cityUrl, isPragueSlug, ordinaci, prijima, specialty } from '../lib/site';

const spec = specialty(Astro.url.searchParams.get('s') ?? '') ?? SPECIALTIES[0];
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 80);
const found = q ? await findPlace(spec.slug, q) : { kind: 'none' as const };
if (found.kind === 'city') return Astro.redirect(cityUrl(spec.slug, found.slug), 302);
if (found.kind === 'near') {
  const p = new URLSearchParams({ s: spec.slug, lat: found.lat.toFixed(4), lng: found.lng.toFixed(4), km: '3', misto: found.label });
  return Astro.redirect(`/blizko?${p}`, 302);
}
const matches = found.kind === 'list' ? found.matches : [];
---
<Base title={`Hledat: ${q || spec.plural}`} description={`${spec.plural} – vyhledávání podle obce.`} noindex activeSpecialty={spec.slug} alt={`/en/search${Astro.url.search}`}>
  <h1>Kde hledáte {spec.acc}?</h1>
  <PlaceSearch specialty={spec.slug} {q} />
  {q && matches.length === 0 && (
    <p class="notice bad">Pro „{q}“ jsme nic nenašli. Zkuste název města (třeba „Kladno“), část Prahy (třeba „Praha 6“ nebo „Dejvice“),
      PSČ nebo ulici. Případně se podívejte na <a href={`/${spec.slug}`}>seznam všech obcí</a>.</p>
  )}
  {matches.length > 0 && (
    <>
      <h2>Vyberte místo</h2>
      <ul class="result-list">
        {matches.map((c) => (
          <li><a href={cityUrl(spec.slug, c.city_slug)}>
            <strong>{c.city.replace(/ \(okres .*\)$/, '')}</strong>
            <span class="muted">{[isPragueSlug(c.city_slug) ? 'Praha' : c.district ? `okres ${c.district}` : c.region, ordinaci(c.n)].filter(Boolean).join(' · ')}</span>
            {c.accepting > 0 && <span class="tile-ok">✓ {prijima(c.accepting)}</span>}
          </a></li>
        ))}
      </ul>
    </>
  )}
</Base>
