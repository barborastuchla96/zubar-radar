---
import Base from '../../layouts/Base.astro';
import { cities } from '../../lib/db';
import PlaceSearch from '../../components/PlaceSearch.astro';
import { cityUrl, ordinaci, placeCompare, plural, specialty } from '../../lib/site';

const spec = specialty(Astro.params.specialty ?? '');
if (!spec) return Astro.rewrite('/404');

const all = await cities(spec.slug, 1);
const byRegion = new Map<string, typeof all>();
for (const c of all) {
  const r = c.region ?? 'Ostatní';
  if (!byRegion.has(r)) byRegion.set(r, []);
  byRegion.get(r)!.push(c);
}
// Regions A–Z with Prague (the launch city) first; places A–Z within each, Prague districts by number.
const PRAGUE = 'Hlavní město Praha';
const regions = [...byRegion.entries()].sort((a, b) =>
  (a[0] === PRAGUE ? -1 : b[0] === PRAGUE ? 1 : placeCompare(a[0], b[0])));
for (const [, list] of regions) list.sort((a, b) => placeCompare(a.city, b.city));
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
---
<Base title={`${spec.plural} – kdo přijímá nové pacienty | podle měst`} description={`${spec.plural} podle měst a krajů. U každé ordinace vidíte, zda přijímá nové pacienty.`} activeSpecialty={spec.slug}>
  <div class="crumbs"><a href="/">Úvod</a> › {spec.plural}</div>
  <h1>{spec.plural} podle měst</h1>
  <p class="muted">{ordinaci(all.reduce((s, c) => s + c.n, 0))} v {all.length.toLocaleString('cs')} {plural(all.length, 'obci', 'obcích', 'obcích')}.</p>
  <PlaceSearch specialty={spec.slug} compact />
  {regions.map(([region, list]) => (
    <section>
      <h2>{region}</h2>
      <p>
        {list.map((c, i) => (
          <>{i > 0 && ' · '}<a href={cityUrl(spec.slug, c.city_slug)}>{c.city}</a> <span class="small muted">({c.n})</span></>
        ))}
      </p>
    </section>
  ))}
</Base>
