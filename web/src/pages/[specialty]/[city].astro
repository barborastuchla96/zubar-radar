---
import SpecialistNote from '../../components/SpecialistNote.astro';
import Base from '../../layouts/Base.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import Map from '../../components/Map.astro';
import AdSlot from '../../components/AdSlot.astro';
import Sponsored from '../../components/Sponsored.astro';
import StatusLegend from '../../components/StatusLegend.astro';
import AlertForm from '../../components/AlertForm.astro';
import { cityProviders, nearby, sponsored } from '../../lib/db';
import { placeUrl } from '../../lib/i18n';
import { SPECIALTIES, breadcrumbLd, cityUrl, factLine, isPragueSlug, monthYear, placeLabel, specialty } from '../../lib/site';

const spec = specialty(Astro.params.specialty ?? '');
if (!spec) return Astro.rewrite('/404');
const rows = await cityProviders(spec.slug, Astro.params.city ?? '');
if (rows.length === 0) return Astro.rewrite('/404');

const city = placeLabel(rows[0].city!, rows[0].city_slug!, rows[0].district);
const sponsors = await sponsored(spec.slug, Astro.params.city!);
const counts = { accepting: 0, waitlist: 0, not_accepting: 0, unknown: 0, mixed: 0 } as Record<string, number>;
for (const r of rows) counts[r.status] = (counts[r.status] ?? 0) + 1;
const known = rows.length - counts.unknown;
const open = counts.accepting + counts.waitlist;
const english = rows.filter((r) => r.english).length;
const located = rows.filter((r) => r.lat != null && r.lng != null);
const center = located.length
  ? { lat: located.reduce((t, r) => t + r.lat!, 0) / located.length, lng: located.reduce((t, r) => t + r.lng!, 0) / located.length }
  : null;
// The register's town is often the postal one (Radotín filed as "Praha 5"), so also list
// practices just over the border that people here would count as theirs.
const here = new Set(rows.map((r) => r.id));
const around = center
  ? (await nearby(spec.slug, center.lat, center.lng, isPragueSlug(Astro.params.city!) ? 2 : 5, rows.length + 6))
      .filter((r) => !here.has(r.id)).slice(0, 6).map(({ km, ...r }) => r)
  : [];
const title = `${spec.seo ?? spec.plural} ${city} – kdo přijímá nové pacienty (${monthYear()})`;
const fact = factLine(city, spec.plural, counts.accepting, rows.length);
const description = `${fact} Kontakty, mapa a zprávy od pacientů.`;
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
const jsonLd = breadcrumbLd(Astro.site, [
  ['Úvod', '/'], [spec.plural, `/${spec.slug}`],
  ...(isPragueSlug(Astro.params.city!) ? [['Praha', cityUrl(spec.slug, 'praha')] as [string, string]] : []),
  [city, cityUrl(spec.slug, Astro.params.city!)],
]);
---
<Base {title} {description} noindex={rows.length < 3} activeSpecialty={spec.slug} {jsonLd} alt={placeUrl('en', spec.slug, Astro.params.city!)}>
  <div class="crumbs"><a href="/">Úvod</a> › <a href={`/${spec.slug}`}>{spec.plural}</a> ›
    {isPragueSlug(Astro.params.city!) && <> <a href={cityUrl(spec.slug, 'praha')}>Praha</a> ›</>} {city}</div>
  <h1>{spec.plural} – {city}</h1>
  <p class="muted fact">{fact}</p>
  <SpecialistNote {spec} />

  {open > 0 ? (
    <>
      <p class="intro">Nahoře najdete ordinace, které podle hlášení <strong>přijímají nové pacienty</strong>.
        U ostatních to zatím nevíme.</p>
      <StatusLegend />
      <div class="filters" role="group" aria-label="Zobrazit">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">Všechny ({rows.length})</button>
        <button class="chip" type="button" data-filter="accepting" aria-pressed="false">Přijímají ({open})</button>
        <button class="chip" type="button" data-filter="unknown" aria-pressed="false">Zatím nevíme ({counts.unknown + counts.mixed})</button>
        {english > 0 && <button class="chip" type="button" data-filter="english" aria-pressed="false">🗣️ Mluví anglicky ({english})</button>}
      </div>
    </>
  ) : (
    // Nobody here is known to accept: say it plainly and offer the two ways to help right away.
    <div class="card empty-state">
      <h2>{known === 0 ? 'Tady nám zatím nikdo nic nenahlásil' : 'Tady zatím nikdo nehlásí, že by přijímali'}</h2>
      <p>Kontakty na všechny ordinace najdete níže. Když zjistíte, jak to v některé je, dejte vědět.
        Ostatní to pak uvidí.</p>
      {center && <p><a href="#upozorneni">📧 Pošleme vám e-mail, až tu někdo začne přijímat</a></p>}
    </div>
  )}

  <details class="map-toggle" open>
    <summary>🗺️ Zobrazit na mapě</summary>
    <Map providers={rows} />
  </details>
  <script is:inline>
    // Phones: practices first, the map only on request.
    if (matchMedia('(max-width: 640px)').matches) document.currentScript.previousElementSibling.open = false;
  </script>

  <Sponsored rows={sponsors} />
  <h2 class="sr-only">Ordinace</h2>
  <div class="grid grid-2" id="list">
    {rows.slice(0, 6).map((p) => <ProviderCard p={p} />)}
  </div>
  <AdSlot name={`city-${spec.slug}`} />
  <div class="grid grid-2" id="list-rest">
    {rows.slice(6).map((p) => <ProviderCard p={p} />)}
  </div>
  <p class="notice ok" id="empty" hidden>V tomto filtru nic není.</p>

  {around.length > 0 && (
    <>
      <h2>Nedaleko – mimo {city}</h2>
      <div class="grid grid-2" id="list-around">
        {around.map((p) => <ProviderCard p={p} />)}
      </div>
    </>
  )}

  {center && <AlertForm {spec} lat={center.lat} lng={center.lng} place={city} radius={isPragueSlug(Astro.params.city!) ? 2 : 5} />}

  <h2>Další obory – {city}</h2>
  <ul class="pills">{SPECIALTIES.filter((s) => s.slug !== spec.slug).map((s) => <li><a href={cityUrl(s.slug, Astro.params.city!)}>{s.plural}</a></li>)}</ul>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('article.provider');
  const groups: Record<string, string[]> = { accepting: ['accepting', 'waitlist'], unknown: ['unknown', 'mixed'] };
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    const f = chip.dataset.filter!;
    let shown = 0;
    cards.forEach((card) => {
      const ok = f === 'all' || (f === 'english' ? card.dataset.english === '1' : groups[f].includes(card.dataset.status!));
      card.hidden = !ok; if (ok) shown++;
    });
    document.getElementById('empty')!.hidden = shown > 0;
  }));
</script>
