---
// Prague hub: the register splits Prague into districts (Praha 1–22), so this
// page ties them together. Static route, so it wins over [city].astro.
import Base from '../../layouts/Base.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { cities, pragueAccepting } from '../../lib/db';
import { SPECIALTIES, byDistrict, cityUrl, isPragueSlug, specialty } from '../../lib/site';

const spec = specialty(Astro.params.specialty ?? '');
if (!spec) return Astro.rewrite('/404');

const districts = (await cities(spec.slug, 1)).filter((c) => isPragueSlug(c.city_slug)).sort(byDistrict);
const total = districts.reduce((t, c) => t + c.n, 0);
const acceptingTotal = districts.reduce((t, c) => t + c.accepting, 0);
const accepting = await pragueAccepting(spec.slug);
const title = `${spec.plural} Praha – kdo bere nové pacienty`;
const description = `${total} ordinací (${spec.plural.toLowerCase()}) v Praze podle městských částí. ` +
  (acceptingTotal ? `${acceptingTotal} podle hlášení přijímá nové pacienty. ` : '') +
  'Ověřeno lidmi, kteří tam volali.';
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
---
<Base {title} {description} activeSpecialty={spec.slug}>
  <div class="crumbs"><a href="/">Úvod</a> › <a href={`/${spec.slug}`}>{spec.plural}</a> › Praha</div>
  <h1>{spec.plural} – Praha</h1>
  <p class="muted">
    {total.toLocaleString('cs')} ordinací ve {districts.length} částech Prahy
    {acceptingTotal > 0 && <> · <strong style="color:var(--ok)">{acceptingTotal} bere nové pacienty</strong></>}
  </p>

  <h2>Kde teď berou</h2>
  {accepting.length > 0 ? (
    <div class="grid grid-2">{accepting.map((p) => <ProviderCard p={p} />)}</div>
  ) : (
    <p class="card">Zatím nikdo nenahlásil, že by tu někdo bral. Vyberte svou část Prahy a pomozte:
      po telefonátu do ordinace stačí jedno kliknutí.</p>
  )}

  <AdSlot name={`city-${spec.slug}`} />

  <h2>Podle městské části</h2>
  <div class="grid grid-cards">
    {districts.map((d) => (
      <a class="card spec-tile" href={cityUrl(spec.slug, d.city_slug)}>
        <strong>{d.city}</strong>
        <span class="small muted">{d.n} ordinací{d.accepting > 0 && <> · <span style="color:var(--ok)">{d.accepting} bere</span></>}</span>
      </a>
    ))}
  </div>

  <h2>Další obory – Praha</h2>
  <p>{SPECIALTIES.filter((s) => s.slug !== spec.slug).map((s, i) => <>{i > 0 && ' · '}<a href={cityUrl(s.slug, 'praha')}>{s.plural}</a></>)}</p>
</Base>
