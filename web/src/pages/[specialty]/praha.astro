---
// Prague hub: the register splits Prague into districts (Praha 1–22), so this
// page ties them together. Static route, so it wins over [city].astro.
import Base from '../../layouts/Base.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import PlaceSearch from '../../components/PlaceSearch.astro';
import StatusLegend from '../../components/StatusLegend.astro';
import Tile from '../../components/Tile.astro';
import AlertForm from '../../components/AlertForm.astro';
import { cities, pragueAccepting } from '../../lib/db';
import { SPECIALTIES, breadcrumbLd, byDistrict, cityUrl, factLine, isPragueSlug, monthYear, specialty } from '../../lib/site';

const spec = specialty(Astro.params.specialty ?? '');
if (!spec) return Astro.rewrite('/404');

const districts = (await cities(spec.slug, 1)).filter((c) => isPragueSlug(c.city_slug)).sort(byDistrict);
const total = districts.reduce((t, c) => t + c.n, 0);
const acceptingTotal = districts.reduce((t, c) => t + c.accepting, 0);
const accepting = await pragueAccepting(spec.slug);
const title = `${spec.plural} Praha – kdo přijímá nové pacienty (${monthYear()})`;
const fact = factLine('Praha', spec.plural, acceptingTotal, total);
const description = `${fact} Přehled podle městských částí, kontakty a hlášení od lidí, kteří tam volali.`;
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
const jsonLd = breadcrumbLd(Astro.site, [['Úvod', '/'], [spec.plural, `/${spec.slug}`], ['Praha', cityUrl(spec.slug, 'praha')]]);
---
<Base {title} {description} activeSpecialty={spec.slug} {jsonLd}>
  <div class="crumbs"><a href="/">Úvod</a> › <a href={`/${spec.slug}`}>{spec.plural}</a> › Praha</div>
  <h1>{spec.plural} – Praha</h1>
  <p class="muted fact">{fact}</p>

  <PlaceSearch specialty={spec.slug} q="Praha " compact />
  <h2>Kde teď přijímají</h2>
  {accepting.length > 0 ? (
    <div class="grid grid-2">{accepting.map((p) => <ProviderCard p={p} />)}</div>
  ) : (
    <p class="card">Zatím nemáme žádnou zprávu, že by tu někdo přijímal. Vyberte svou část Prahy a pomozte nám.
      Po telefonátu do ordinace stačí jedno kliknutí.</p>
  )}

  {accepting.length > 0 && <StatusLegend />}
  <AdSlot name={`city-${spec.slug}`} />

  <h2>Podle městské části</h2>
  <div class="grid grid-cards">
    {districts.map((d) => <Tile href={cityUrl(spec.slug, d.city_slug)} title={d.city} n={d.n} accepting={d.accepting} />)}
  </div>

  <AlertForm {spec} lat={50.0755} lng={14.4378} place="Praha" radius={10} />

  <h2>Další obory v Praze</h2>
  <ul class="pills">{SPECIALTIES.filter((s) => s.slug !== spec.slug).map((s) => <li><a href={cityUrl(s.slug, 'praha')}>{s.plural}</a></li>)}</ul>
</Base>
